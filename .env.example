# Gmail Configuration for sending emails
# Your Gmail address
GMAIL_USER=your_gmail_address@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate this at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_app_password_here

# Admin email address to receive registration notifications
ADMIN_EMAIL=your_admin_email@example.com
# Gallery admin (/admin/photos): GitHub token used to commit photo deletions.
# Fine-grained token with "Contents: Read and write" on the site's repo.
# Not needed when running locally (files are deleted from disk instead).
GITHUB_TOKEN=
# Optional overrides
# GITHUB_REPO=adirosh27/PeterPanBoca
# GITHUB_BRANCH=main
